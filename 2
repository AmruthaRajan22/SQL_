
Q1. WHERE + AND
Display employees who work in the IT department and earn more than ₹35,000.
SELECT *
FROM Employees
WHERE Department='IT' AND Salary>35000;


Q2. BETWEEN
Display employees whose salary is between ₹30,000 and ₹40,000, inclusive.
SELECT *
FROM Employees 
WHERE Salary >=30000 AND Salary<=40000; 
OR
WHERE Salary BETWEEN 30000 AND 40000

Q3. MAX()
Find the highest salary in the table.
SELECT MAX(Salary)
FROM Employees;

Q4. GROUP BY + AVG()
Find the average salary for each department.
SELECT Department, AVG(Salary)
FROM Employees
GROUP BY Department;

Q5. DELETE
Delete the employee record whose ID is 4.
DELETE  FROM Employees
WHERE ID=4;
